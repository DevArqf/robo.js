{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"outDir": ".robo/build"
	},
	"include": ["src/**/*", "robo.config.ts"],
	"exclude": ["node_modules", ".robo"]
}
